{
  "buildCommand": "rsbuild build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/tools/qr",
      "destination": "/tools/qr/",
      "permanent": false
    },
    {
      "source": "/tools/mcp-xray",
      "destination": "/tools/mcp-xray/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/q/:slug",
      "destination": "https://qr-ninja-sigma.vercel.app/api/q?slug=:slug"
    },
    {
      "source": "/tools/qr/",
      "destination": "https://qr-ninja-sigma.vercel.app/"
    },
    {
      "source": "/tools/qr/:path*",
      "destination": "https://qr-ninja-sigma.vercel.app/:path*"
    },
    {
      "source": "/tools/mcp-xray/",
      "destination": "https://mcp-xray.vercel.app/"
    },
    {
      "source": "/tools/mcp-xray/:path*",
      "destination": "https://mcp-xray.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
