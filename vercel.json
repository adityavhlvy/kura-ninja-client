{
  "buildCommand": "rsbuild build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/tools/qr", "destination": "/tools/qr/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/q/:slug", "destination": "https://adityavhlvy-qr.vercel.app/api/q/:slug" },
    { "source": "/tools/qr/", "destination": "https://adityavhlvy-qr.vercel.app/" },
    { "source": "/tools/qr/:path*", "destination": "https://adityavhlvy-qr.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
